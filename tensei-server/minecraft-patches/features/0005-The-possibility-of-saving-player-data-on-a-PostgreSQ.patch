From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Euphyllia Bierque <bierque.euphyllia@gmail.com>
Date: Tue, 5 May 2026 15:02:08 +0200
Subject: [PATCH] The possibility of saving player data on a PostgreSQL server
 allows for a kind of inter-server synchronization.


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index e0cd69a8bd93e0f6807d1da6f909abebdc8fd517..d349be3d9fbde05e7c69289e14a0805929b7fcc8 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -207,7 +207,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
     public static final Supplier<GameRules> DEFAULT_GAME_RULES = () -> new GameRules(WorldDataConfiguration.DEFAULT.enabledFeatures());
     public static final NameAndId ANONYMOUS_PLAYER_PROFILE = new NameAndId(Util.NIL_UUID, "Anonymous Player");
     public LevelStorageSource.LevelStorageAccess storageSource;
-    public final PlayerDataStorage playerDataStorage;
+    public PlayerDataStorage playerDataStorage; // TenseiMC - non-final to allow Postgres swap
     private final SavedDataStorage savedDataStorage;
     // Paper - per-level GameRules
     private ServerConnectionListener connection;
@@ -1132,7 +1132,13 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         // Folia end - region threading
         this.savedDataStorage.close();
         this.resources.close();
-
+        // TenseiMC start - shutdown Postgres storage
+        try {
+            fr.euphyllia.tenseimc.storage.database.postgres.PostgresManager.shutdown();
+        } catch (Exception ex) {
+            LOGGER.error("Failed to shutdown TenseiMC storage", ex);
+        }
+        // TenseiMC end
         try {
             this.storageSource.close();
         } catch (IOException e) {
@@ -1310,7 +1316,31 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             if (!this.initServer()) {
                 throw new IllegalStateException("Failed to initialize server");
             }
+            // TenseiMC start - initialize Postgres storage
+            try {
+                fr.euphyllia.tenseimc.storage.database.postgres.PostgresManager.init(
+                        fr.euphyllia.tenseimc.storage.config.StorageConfigMapper.toStorageConfig(
+                                fr.euphyllia.tenseimc.configuration.TenseiConfigGlobal.get().storage
+                        ),
+                        this,
+                        this.getServerDirectory()
+                );
 
+                if (fr.euphyllia.tenseimc.storage.database.postgres.PostgresManager.isEnabled()) {
+                    var pgStorage =
+                            new fr.euphyllia.tenseimc.storage.extension.postgresql.PostgresPlayerDataStorage(
+                                    this.storageSource,
+                                    this.fixerUpper
+                            );
+                    this.playerDataStorage = pgStorage;
+                    this.getPlayerList().playerIo = pgStorage;
+                    LOGGER.info("PlayerDataStorage swapped to PostgresPlayerDataStorage");
+                }
+            } catch (Exception ex) {
+                LOGGER.error("Failed to initialize TenseiMC storage", ex);
+                throw new IllegalStateException("Storage initialization failed", ex);
+            }
+            // TenseiMC end
             this.nextTickTimeNanos = Util.getNanos();
             this.initTickSchedule(); // Paper - improve tick loop
             this.statusIcon = this.loadStatusIcon().orElse(null);
diff --git a/net/minecraft/server/players/PlayerList.java b/net/minecraft/server/players/PlayerList.java
index d67b1fa746e117f27c494a70f68e40a46dd29f1c..0c24ecfd9581fd0ad98c5a1394227314e545577c 100644
--- a/net/minecraft/server/players/PlayerList.java
+++ b/net/minecraft/server/players/PlayerList.java
@@ -123,7 +123,7 @@ public abstract class PlayerList {
     // private final Map<UUID, ServerStatsCounter> stats = Maps.newHashMap();
     // private final Map<UUID, PlayerAdvancements> advancements = Maps.newHashMap();
     // CraftBukkit end
-    public final PlayerDataStorage playerIo;
+    public PlayerDataStorage playerIo;
     private final LayeredRegistryAccess<RegistryLayer> registries;
     private int viewDistance;
     private int simulationDistance;
@@ -224,6 +224,37 @@ public abstract class PlayerList {
     public void placeNewPlayer(final Connection connection, final ServerPlayer player, final CommonListenerCookie cookie) {
         player.isRealPlayer = true; // Paper
         player.loginTime = System.currentTimeMillis(); // Paper - Replace OfflinePlayer#getLastPlayed
+        // TenseiMC start - acquire session lock
+        if (fr.euphyllia.tenseimc.storage.database.postgres.PostgresManager.isEnabled()) {
+            final UUID lockUuid = player.getUUID();
+            try {
+                boolean acquired = fr.euphyllia.tenseimc.storage.database.postgres.PostgresManager.playerLock()
+                        .tryAcquire(lockUuid)
+                        .get(2, java.util.concurrent.TimeUnit.SECONDS);
+
+                if (!acquired) {
+                    String msg = fr.euphyllia.tenseimc.storage.database.postgres.PostgresManager.config()
+                            .resilience().login().alreadyConnectedKickMessage();
+                    connection.disconnect(io.papermc.paper.adventure.PaperAdventure.asVanilla(
+                            net.kyori.adventure.text.minimessage.MiniMessage.miniMessage().deserialize(msg)
+                    ));
+                    return;
+                }
+                fr.euphyllia.tenseimc.storage.database.postgres.PostgresManager.lockHeartbeat().track(lockUuid);
+            } catch (java.util.concurrent.TimeoutException | java.util.concurrent.ExecutionException ex) {
+                LOGGER.error("Failed to acquire session lock for {}", lockUuid, ex);
+                String msg = fr.euphyllia.tenseimc.storage.database.postgres.PostgresManager.config()
+                        .resilience().login().unavailableKickMessage();
+                connection.disconnect(io.papermc.paper.adventure.PaperAdventure.asVanilla(
+                        net.kyori.adventure.text.minimessage.MiniMessage.miniMessage().deserialize(msg)
+                ));
+                return;
+            } catch (InterruptedException ex) {
+                Thread.currentThread().interrupt();
+                return;
+            }
+        }
+        // TenseiMC end
         NameAndId gameProfile = player.nameAndId();
         UserNameToIdResolver profileCache = this.server.services().nameToIdCache();
         Optional<NameAndId> oldProfile = profileCache.get(gameProfile.id());
@@ -492,6 +523,28 @@ public abstract class PlayerList {
         }
         new io.canvasmc.canvas.event.PlayerSaveEvent(player.getBukkitEntity(), false).callEvent(); // Canvas - player save event
     }
+    // TenseiMC start - explicit logout save with proper SaveOperation context
+    public void saveOnLogout(final ServerPlayer player) {
+        if (!player.getBukkitEntity().isPersistent()) return;
+        player.lastSave = System.nanoTime();
+
+        if (this.playerIo instanceof fr.euphyllia.tenseimc.storage.extension.postgresql.PostgresPlayerDataStorage pgStorage) {
+            pgStorage.saveWithOperation(player, fr.euphyllia.tenseimc.storage.model.SaveOperation.LOGOUT);
+        } else {
+            this.playerIo.save(player);
+        }
+
+        ServerStatsCounter stats = player.getStats();
+        if (stats != null) {
+            stats.save();
+        }
+        PlayerAdvancements advancements = player.getAdvancements();
+        if (advancements != null) {
+            advancements.save();
+        }
+        new io.canvasmc.canvas.event.PlayerSaveEvent(player.getBukkitEntity(), false).callEvent();
+    }
+    // TenseiMC end
 
     public net.kyori.adventure.text.@Nullable Component remove(final ServerPlayer player) { // CraftBukkit - return string // Paper - return Component
         // Paper start - Fix kick event leave message not being sent
@@ -521,11 +574,15 @@ public abstract class PlayerList {
             player.containerMenu.setCarried(net.minecraft.world.item.ItemStack.EMPTY);
             player.drop(carried, false);
         }
-        // Paper end - Drop carried item when player has disconnected
-        this.save(player);
-        // TenseiMC start - force save stats + advancements disconnect
-        player.getStats().save();
-        player.getAdvancements().save();
+        // TenseiMC start - save with LOGOUT context + release session lock
+        this.saveOnLogout(player);
+
+        if (fr.euphyllia.tenseimc.storage.database.postgres.PostgresManager.isEnabled()) {
+            final UUID lockUuid = player.getUUID();
+            fr.euphyllia.tenseimc.storage.database.postgres.PostgresManager.lockHeartbeat().untrack(lockUuid);
+            fr.euphyllia.tenseimc.storage.database.postgres.PostgresManager.playerLock().release(lockUuid);
+        }
+        // TenseiMC end
         // TenseiMC end - force save stats + advancements disconnect
         if (player.isPassenger()) {
             Entity vehicle = player.getRootVehicle();
@@ -1345,6 +1402,16 @@ public abstract class PlayerList {
         }
     }
     public ServerStatsCounter getPlayerStats(final GameProfile gameProfile) {
+        // TenseiMC start - Postgres-backed stats
+        if (fr.euphyllia.tenseimc.storage.database.postgres.PostgresManager.isEnabled()) {
+            return new fr.euphyllia.tenseimc.storage.extension.postgresql.PostgresServerStatsCounter(
+                    this.server,
+                    gameProfile.id(),
+                    gameProfile.name(),
+                    this.server.getFixerUpper()
+            );
+        }
+        // TenseiMC end
             Path targetFile = this.locateStatsFile(gameProfile);
             return new ServerStatsCounter(this.server, targetFile);
     }
@@ -1376,12 +1443,17 @@ public abstract class PlayerList {
     public PlayerAdvancements getPlayerAdvancements(final ServerPlayer player) {
         UUID uuid = player.getUUID();
         PlayerAdvancements result = player.getAdvancements(); // CraftBukkit
-        if (result == null) {
+        // TenseiMC start - Postgres-backed advancements
+        if (fr.euphyllia.tenseimc.storage.database.postgres.PostgresManager.isEnabled()) {
+            result = new fr.euphyllia.tenseimc.storage.extension.postgresql.PostgresPlayerAdvancements(
+                    this.server.getFixerUpper(), this, this.server.getAdvancements(), player
+            );
+        } else {
             Path uuidStatsFile = this.server.getWorldPath(LevelResource.PLAYER_ADVANCEMENTS_DIR).resolve(uuid + ".json");
             result = new PlayerAdvancements(this.server.getFixerUpper(), this, this.server.getAdvancements(), uuidStatsFile, player);
             // this.advancements.put(uuid, result); // CraftBukkit
         }
-
+        // TenseiMC end
         result.setPlayer(player);
         return result;
     }

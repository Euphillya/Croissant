From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bierque Euphyllia <bierque.euphyllia@gmail.com>
Date: Fri, 1 May 2026 13:32:47 +0200
Subject: [PATCH] Configurable piston push limit


diff --git a/net/minecraft/world/level/block/piston/PistonStructureResolver.java b/net/minecraft/world/level/block/piston/PistonStructureResolver.java
index 4a2cd2241a65fe051aae0b87e33580784bd9c2cb..2784a1d4a820d7ca6cfa42622409e12f75d0310c 100644
--- a/net/minecraft/world/level/block/piston/PistonStructureResolver.java
+++ b/net/minecraft/world/level/block/piston/PistonStructureResolver.java
@@ -90,7 +90,7 @@ public class PistonStructureResolver {
         }
 
         int blockCount = 1;
-        if (blockCount + this.toPush.size() > 12) {
+        if (blockCount + this.toPush.size() > this.level.tensei.blocks.piston.pushLimit) {
             return false;
         }
 
@@ -105,7 +105,7 @@ public class PistonStructureResolver {
                 break;
             }
 
-            if (++blockCount + this.toPush.size() > 12) {
+            if (++blockCount + this.toPush.size() > this.level.tensei.blocks.piston.pushLimit) {
                 return false;
             }
         }
@@ -149,7 +149,7 @@ public class PistonStructureResolver {
                 return true;
             }
 
-            if (this.toPush.size() >= 12) {
+            if (this.toPush.size() >= this.level.tensei.blocks.piston.pushLimit) {
                 return false;
             }
 

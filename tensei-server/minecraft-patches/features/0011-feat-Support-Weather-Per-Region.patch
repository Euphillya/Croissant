index 75efccc9dea9281dcfbc03251d4f9fd269297d7e..0330a42c712ea0f7846ee032c9e6eb96bcf230ad 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -3798,6 +3798,58 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
         }
     }
 
+    private boolean tensei$regionalWeatherInit;
+    private boolean tensei$regionalWasRaining;
+    private float tensei$regionalRainLevel;
+    private float tensei$regionalThunderLevel;
+    public void tensei$syncRegionalWeather(final io.papermc.paper.threadedregions.RegionizedWorldData.RegionalWeatherState st) {
+        if (this.weatherType != null) {
+            return;
+        }
+
+        if (st == null || this.connection == null) {
+            return;
+        }
+
+        final boolean raining = st.raining;
+        final float rainLevel = st.rainLevel;
+        final float thunderLevel = st.thunderLevel;
+
+        // First sync (join / region move)
+        if (!this.tensei$regionalWeatherInit) {
+            this.connection.send(new ClientboundGameEventPacket(
+                    raining ? ClientboundGameEventPacket.START_RAINING : ClientboundGameEventPacket.STOP_RAINING, 0.0F
+            ));
+            this.connection.send(new ClientboundGameEventPacket(ClientboundGameEventPacket.RAIN_LEVEL_CHANGE, rainLevel));
+            this.connection.send(new ClientboundGameEventPacket(ClientboundGameEventPacket.THUNDER_LEVEL_CHANGE, thunderLevel));
+
+            this.tensei$regionalWeatherInit = true;
+            this.tensei$regionalWasRaining = raining;
+            this.tensei$regionalRainLevel = rainLevel;
+            this.tensei$regionalThunderLevel = thunderLevel;
+            return;
+        }
+
+        // START/STOP raining
+        if (this.tensei$regionalWasRaining != raining) {
+            this.connection.send(new ClientboundGameEventPacket(
+                    raining ? ClientboundGameEventPacket.START_RAINING : ClientboundGameEventPacket.STOP_RAINING, 0.0F
+            ));
+            this.tensei$regionalWasRaining = raining;
+        }
+
+        // Level changes (epsilon to avoid spam)
+        if (Math.abs(this.tensei$regionalRainLevel - rainLevel) > 1.0E-4F) {
+            this.connection.send(new ClientboundGameEventPacket(ClientboundGameEventPacket.RAIN_LEVEL_CHANGE, rainLevel));
+            this.tensei$regionalRainLevel = rainLevel;
+        }
+
+        if (Math.abs(this.tensei$regionalThunderLevel - thunderLevel) > 1.0E-4F) {
+            this.connection.send(new ClientboundGameEventPacket(ClientboundGameEventPacket.THUNDER_LEVEL_CHANGE, thunderLevel));
+            this.tensei$regionalThunderLevel = thunderLevel;
+        }
+    }
+
     public void tickWeather() {
         if (this.weatherType == null) return;
 

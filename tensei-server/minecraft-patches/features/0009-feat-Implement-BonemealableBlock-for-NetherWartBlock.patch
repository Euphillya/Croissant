From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Euphyllia Bierque <bierque.euphyllia@gmail.com>
Date: Thu, 7 May 2026 13:08:50 +0200
Subject: [PATCH] feat: Implement BonemealableBlock for NetherWartBlock


diff --git a/net/minecraft/world/level/block/NetherWartBlock.java b/net/minecraft/world/level/block/NetherWartBlock.java
index c9cfc3096e6fb04493f906e0f6cb70cda3648a4a..efe430d315e84472e7158299e15f412ce2db4e9d 100644
--- a/net/minecraft/world/level/block/NetherWartBlock.java
+++ b/net/minecraft/world/level/block/NetherWartBlock.java
@@ -17,7 +17,7 @@ import net.minecraft.world.level.block.state.properties.IntegerProperty;
 import net.minecraft.world.phys.shapes.CollisionContext;
 import net.minecraft.world.phys.shapes.VoxelShape;
 
-public class NetherWartBlock extends VegetationBlock {
+public class NetherWartBlock extends VegetationBlock implements BonemealableBlock {
     public static final MapCodec<NetherWartBlock> CODEC = simpleCodec(NetherWartBlock::new);
     public static final int MAX_AGE = 3;
     public static final IntegerProperty AGE = BlockStateProperties.AGE_3;
@@ -66,4 +66,34 @@ public class NetherWartBlock extends VegetationBlock {
     protected void createBlockStateDefinition(final StateDefinition.Builder<Block, BlockState> builder) {
         builder.add(AGE);
     }
+
+    @Override
+    public boolean isValidBonemealTarget(final LevelReader level, final BlockPos pos, final BlockState state) {
+        if (level instanceof ServerLevel serverLevel
+                && !serverLevel.tensei.blocks.netherWart.bonemealEnabled) {
+            return false;
+        }
+        return state.getValue(AGE) < MAX_AGE;
+    }
+
+    @Override
+    public boolean isBonemealSuccess(final net.minecraft.world.level.Level level, final RandomSource random, final BlockPos pos, final BlockState state) {
+        if (level instanceof ServerLevel serverLevel) {
+            return random.nextFloat() < serverLevel.tensei.blocks.netherWart.bonemealSuccessChance;
+        }
+        return true;
+    }
+
+    @Override
+    public void performBonemeal(final ServerLevel level, final RandomSource random, final BlockPos pos, final BlockState state) {
+        int age = state.getValue(AGE);
+        int growAmount = level.tensei.blocks.netherWart.bonemealGrowAmount;
+        int newAge = Math.min(age + growAmount, MAX_AGE);
+
+        org.bukkit.craftbukkit.event.CraftEventFactory.handleBlockGrowEvent(level, pos, state.setValue(AGE, newAge), Block.UPDATE_CLIENTS);
+
+        if (level.tensei.blocks.netherWart.bonemealParticles) {
+            level.sendParticles(net.minecraft.core.particles.ParticleTypes.HAPPY_VILLAGER, pos.getX() + 0.5, pos.getY() + 0.5, pos.getZ() + 0.5, 9, 0.25, 0.25, 0.25, 0.0);
+        }
+    }
 }

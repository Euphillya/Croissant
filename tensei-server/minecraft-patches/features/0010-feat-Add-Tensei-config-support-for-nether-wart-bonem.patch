From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Euphyllia Bierque <bierque.euphyllia@gmail.com>
Date: Thu, 21 May 2026 15:42:36 +0200
Subject: [PATCH] feat: Add Tensei config support for nether wart bonemeal


diff --git a/net/minecraft/world/level/block/NetherWartBlock.java b/net/minecraft/world/level/block/NetherWartBlock.java
index b3788bc76ec54546b9040ffea01f06e7756af13a..1a7776384eebe8fff0648fda7ba2f46e845feba2 100644
--- a/net/minecraft/world/level/block/NetherWartBlock.java
+++ b/net/minecraft/world/level/block/NetherWartBlock.java
@@ -84,7 +84,10 @@ public class NetherWartBlock extends VegetationBlock implements BonemealableBloc
         final BlockPos pos,
         final BlockState state
     ) {
-        return level.canvasConfig().farming.netherWartBonemealable;
+        if (level.canvasConfig().farming.netherWartBonemealable) {
+            return random.nextFloat() < level.tensei.blocks.netherWart.bonemealSuccessChance;
+        }
+        return false;
     }
 
     @Override
@@ -103,7 +106,9 @@ public class NetherWartBlock extends VegetationBlock implements BonemealableBloc
     }
 
     private int getBonemealAgeIncrease(final net.minecraft.world.level.Level level) {
-        return net.minecraft.util.Mth.nextInt(level.getRandom(), 1, 3);
+        int amount = level.tensei.blocks.netherWart.bonemealGrowAmount;
+        if (amount == -1) return net.minecraft.util.Mth.nextInt(level.getRandom(), 1, 3);
+        return amount;
     }
 
     private BlockState getStateForAge(final int age) {
